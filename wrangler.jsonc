// Cloudflare Workers configuration for veratekdesign.com.
// Docs: https://developers.cloudflare.com/workers/wrangler/configuration/
{
  "name": "veratek-homepage",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",

  // The website itself: every file in public/ is served as-is.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },

  "vars": {
    // Where contact form emails go (Google Group).
    "CONTACT_TO": "info@veratekdesign.com",
    // Google Workspace user the form sends as (through the Gmail API). Also Cc'd, because Gmail
    // won't show the sender its own copy of a message to a group it belongs to.
    "GMAIL_SENDER": "anthony@veratekdesign.com",
    // From address on contact form emails. Must be GMAIL_SENDER or one of its "Send mail as" aliases.
    "CONTACT_FROM": "website@veratekdesign.com"
  },

  // Secrets (not stored here): TURNSTILE_SECRET_KEY and GOOGLE_SERVICE_ACCOUNT. See README.

  "observability": { "enabled": true }
}
