# Copy to .dev.vars for local testing with `npx wrangler dev`.

# Cloudflare's always-pass Turnstile test secret. Works only with the test site key
# 1x00000000000000000000AA in public/contact-us.html (swap it in temporarily, don't commit).
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# The Google service account's JSON key file contents, on one line, inside single quotes.
# Local tests send real email through Gmail.
GOOGLE_SERVICE_ACCOUNT='{"type":"service_account","client_email":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"}'
